{
  "name": "cubeworks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/*.test.js",
    "eval": "node scripts/eval-detector.mjs",
    "eval:mlx": "node scripts/eval-mlx.mjs",
    "mlx": "./.venv-mlx/bin/python mlx-detect/server.py",
    "eval:pipeline": "node scripts/eval-pipeline.mjs",
    "bench": "node scripts/bench-solver.mjs",
    "bench:pdb": "node --max-old-space-size=8192 scripts/bench-solver.mjs --pdb",
    "metrics": "node scripts/collect-metrics.mjs",
    "train": "./.venv-mlx/bin/python mlx-solver/davi.py",
    "watch:train": "tail -f mlx-solver/wings_train.log"
  },
  "dependencies": {
    "cubejs": "^1.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
